{
  "name": "@webmobix/form-components-react",
  "version": "0.2.0",
  "type": "module",
  "description": "React wrappers for the @webmobix/form-components Stencil web components",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webmobix/form-builder.git",
    "directory": "packages/form-components-react"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "npm run tsc",
    "prepublishOnly": "npm run tsc",
    "tsc": "tsc -p . --outDir ./dist",
    "prebuild": "npm run build --workspace @webmobix/form-components"
  },
  "dependencies": {
    "@stencil/react-output-target": "^1.6.1",
    "@webmobix/form-components": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
