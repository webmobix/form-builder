{
  "name": "@webmobix/form-components",
  "version": "0.1.0",
  "description": "Form field, canvas, and palette web components (Stencil) — plain HTML / Preact via dist-custom-elements; typed React wrappers ship in @webmobix/form-components-react",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/wb-form/wb-form.esm.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/wb-form/wb-form.esm.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/wb-form/wb-form.cjs.js"
      }
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    },
    "./dist/*": {
      "import": "./dist/*",
      "types": "./dist/*"
    },
    "./dist/components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./components/*": {
      "import": "./dist/components/*.js",
      "types": "./dist/components/*.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webmobix/form-builder.git",
    "directory": "packages/form-components"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "stencil generate"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@stencil/core": "^4.27.1 || ^5.0.0-0",
    "@stencil/react-output-target": "^1.6.1",
    "@stencil/vitest": "^1.8.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.0",
    "typescript": "^5.9.0",
    "@vitest/browser-playwright": "^4.0.0",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.52.0",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
