{
  "name": "@webmobix/form-components",
  "version": "0.0.1",
  "description": "Form field, canvas, and palette web components (Stencil) — plain HTML / React / Preact via dist-custom-elements",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/wb-form/wb-form.esm.js",
  "exports": {
    ".": {
      "import": "./dist/wb-form/wb-form.esm.js",
      "require": "./dist/wb-form/wb-form.cjs.js"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webmobix/form-builder.git",
    "directory": "packages/form-components"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil-test --prod",
    "test:watch": "stencil-test --prod --watch",
    "generate": "stencil generate"
  },
  "devDependencies": {
    "@stencil/core": "^4.27.1 || ^5.0.0-0",
    "@stencil/vitest": "^1.8.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.5",
    "@vitest/browser-playwright": "^4.0.0",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.52.0",
    "vitest": "^4.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
