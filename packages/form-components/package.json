{
  "name": "@webmobix/form-components",
  "version": "0.8.1",
  "description": "Form field, canvas, and palette web components (Stencil) — plain HTML / Preact via dist-custom-elements; typed React wrappers ship in @webmobix/form-components-react",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/wb-form/wb-form.esm.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/wb-form/wb-form.esm.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/wb-form/wb-form.cjs.js"
      }
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    },
    "./dist/*": {
      "import": "./dist/*",
      "types": "./dist/*"
    },
    "./dist/components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./components/*": {
      "import": "./dist/components/*.js",
      "types": "./dist/components/*.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webmobix/form-builder.git",
    "directory": "packages/form-components"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build",
    "prepublishOnly": "stencil build",
    "start": "stencil build --dev --watch --serve --no-open",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "stencil generate"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dompurify": "^3.4.16"
  },
  "devDependencies": {
    "@stencil/core": "^4.45.1",
    "@stencil/react-output-target": "^1.6.2",
    "@stencil/vitest": "^1.15.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2",
    "@vitest/browser-playwright": "^4.1.10",
    "jest": "^30.5.2",
    "jest-cli": "^30.5.2",
    "jsdom": "^30.1.2",
    "playwright": "^1.63.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
